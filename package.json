{
	"name": "retropad",
	"private": true,
	"description": "RetroPad is your digital gaming notebook, like your vintage gaming binder, brought into the modern world. Organize your game notes and collaborate with others.",
	"author": "Steve Crow <steve@retropad.io>",
	"license": "MIT",
	"homepage": "https://retropad.io",
	"repository": {
		"type": "git",
		"url": "https://github.com/cr0wst/retropad.git"
	},
	"bugs": {
		"url": "https://github.com/cr0wst/retropad/issues"
	},
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "npm run check && npm run lint && npm run test && vite build",
		"migrate:generate": "drizzle-kit generate",
		"migrate": "wrangler d1 migrations apply retro-pad-db",
		"migrate:remote": "wrangler d1 migrations apply retro-pad-db --remote",
		"preview": "npm run build && wrangler dev --port 5173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check .",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:watch": "vitest",
		"cf-typegen": "wrangler types && mv worker-configuration.d.ts src/"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "^1.0.8",
		"@cloudflare/workers-types": "^4.20250419.0",
		"@iconify-json/mdi": "^1.2.3",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"@sveltejs/adapter-cloudflare": "^7.0.1",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.3",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/jest-dom": "^6.6.3",
		"@testing-library/svelte": "^5.2.7",
		"@types/better-sqlite3": "^7.6.13",
		"drizzle-kit": "^0.31.0",
		"jsdom": "^26.1.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"sveltekit-superforms": "^2.24.1",
		"tailwindcss": "^4.0.0",
		"tsx": "^4.19.3",
		"typescript": "^5.0.0",
		"unplugin-icons": "^22.1.0",
		"vite": "^6.2.5",
		"vitest": "^1.6.1",
		"wrangler": "^4.12.0",
		"zod": "^3.24.3"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@fontsource/inter": "^5.2.5",
		"@libsql/client": "^0.15.4",
		"@types/cheerio": "^0.22.35",
		"arctic": "^3.6.0",
		"better-sqlite3": "^11.9.1",
		"clsx": "^2.1.1",
		"dotenv": "^16.5.0",
		"drizzle-orm": "^0.42.0",
		"nanoid": "^5.1.5",
		"tailwind-merge": "^3.2.0",
		"ulid": "^3.0.0"
	}
}
